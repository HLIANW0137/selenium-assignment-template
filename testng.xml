<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cyclos Selenium Suite" verbose="1">
    <listeners>
        <listener class-name="com.example.listeners.ScreenshotListener"/>
    </listeners>
    <test name="Cyclos Tests">
        <classes>
            <class name="com.example.tests.LoginTests"/>
            <class name="com.example.tests.ProfileTests"/>
            <class name="com.example.tests.NavigationTests"/>
            <class name="com.example.tests.AdvancedTests"/>
        </classes>
    </test>
</suite>
